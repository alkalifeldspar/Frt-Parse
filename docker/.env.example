# Copy to docker/.env and fill in. docker compose reads it automatically.

# --- Required ---------------------------------------------------------------
# MySQL root password. Only applied when the mysql-data volume is first created;
# to change it later, use ALTER USER inside MySQL and then update it here too.
MYSQL_ROOT_PASSWORD=change-me

# Admin UI login (HTTP Basic auth). Put the UI behind HTTPS if it is exposed
# beyond a trusted network.
UI_USERNAME=admin
UI_PASSWORD=change-me-too

# --- Optional ---------------------------------------------------------------
# Name of the live database. Staging and previous copies are <name>_staging
# and <name>_previous.
#FRT_DB_NAME=FRT

# Read-only MySQL account (SELECT on the live database) for apps that consume
# the data. Created or updated each time the container starts.
#FRT_READONLY_USER=frt_reader
#FRT_READONLY_PASSWORD=

# Host ports / interfaces
#UI_PORT=8080
#UI_BIND=0.0.0.0
#MYSQL_PORT=3306
#MYSQL_BIND=127.0.0.1

# parse_frt.py worker processes: 1 = sequential (lowest memory), 0 = one per CPU core.
#PARSE_WORKERS=1
# split_frn.py writer threads
#SPLIT_WRITERS=2

# Refuse to swap if the new data has fewer than this fraction of the live FRN count.
#MIN_ROW_RATIO=0.9

# Keep the replaced database as <name>_previous for one-click rollback.
# Costs one extra copy of the data on disk.
#KEEP_PREVIOUS=true

#TZ=America/Toronto
